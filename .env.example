# MediConnect Clinical Ecosystem Environment Configuration

# Database
# If MONGODB_URI is provided, MediConnect connects to your MongoDB cluster.
# If left empty in development, MediConnect automatically starts an in-memory/embedded MongoDB engine.
MONGODB_URI=

# Authentication
BETTER_AUTH_SECRET=mediconnect_secret_jwt_key_2026_clinical_secure_token
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Maps Platform (Optional: works with interactive preview canvas if not set)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# SMS & Notifications (Twilio / MessageBird / Simulated Gateway)
SMS_PROVIDER=simulated
SMS_API_KEY=
SMS_FROM_PHONE=+18005550911

# Node Environment
NODE_ENV=development
